# Proton Pass references for the `prod` stage (vault "Billet Release"). Never put real values here.
# Run: PROTON_PASS_AGENT_REASON="<reason>" pp run --env-file .env.pass.release -- pnpm exec alchemy deploy --stage prod
# See .env.pass and docs/alchemy.md.
#
# Planned: the vault and its "cloudflare" item are not created yet.
# The owner must create the item "Apple" in this vault first, with the fields APNS_KEY, APNS_KEY_ID,
# APPLE_SIGN_IN_KEY and APPLE_SIGN_IN_KEY_ID (copy the values from vault "Billet", item "Apple":
# the same keys work for every stage). A prod deploy stops with a message until they resolve.
CLOUDFLARE_ACCOUNT_ID=pass://Billet Release/cloudflare/account_id
CLOUDFLARE_API_TOKEN=pass://Billet Release/cloudflare/api_token
APNS_KEY=pass://Billet Release/Apple/APNS_KEY
APNS_KEY_ID=pass://Billet Release/Apple/APNS_KEY_ID
APPLE_SIGN_IN_KEY=pass://Billet Release/Apple/APPLE_SIGN_IN_KEY
APPLE_SIGN_IN_KEY_ID=pass://Billet Release/Apple/APPLE_SIGN_IN_KEY_ID
