# Proton Pass references for the `prod` stage (vault "Billet Release"). Never put real values here.
# Run: PROTON_PASS_AGENT_REASON="<reason>" pp run --env-file .env.pass.release -- pnpm exec alchemy deploy --stage prod
# See .env.pass and docs/alchemy.md.
#
# Planned: the vault and its "cloudflare" item are not created yet.
# The Apple keys are account-wide, so prod reads the same item as dev (vault "Billet", item "Apple").
# A prod deploy stops with a message naming any variable that does not resolve.
CLOUDFLARE_ACCOUNT_ID=pass://Billet Release/cloudflare/account_id
CLOUDFLARE_API_TOKEN=pass://Billet Release/cloudflare/api_token
APNS_KEY=pass://Billet/Apple/APNS_KEY
APNS_KEY_ID=pass://Billet/Apple/APNS_KEY_ID
APPLE_SIGN_IN_KEY=pass://Billet/Apple/APPLE_SIGN_IN_KEY
APPLE_SIGN_IN_KEY_ID=pass://Billet/Apple/APPLE_SIGN_IN_KEY_ID
