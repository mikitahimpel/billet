# Proton Pass references for the `prod` stage. Never put real values here.
# This file is the single list of what prod needs: scripts/sync-prod-secrets.sh copies exactly
# these variables into the GitHub environment `prod`, and the deploy workflow reads them there.
# By hand: PROTON_PASS_AGENT_REASON="<reason>" pp run --env-file .env.pass.release -- pnpm exec alchemy deploy --stage prod
# Only the owner deploys prod (docs/alchemy.md#deploy-workflow).
#
# Item titles and field names must match exactly (case-sensitive); spaces are fine.
# Cloudflare: item `Cloudflare` in vault "Ourio Release", a token separate from dev's.
CLOUDFLARE_ACCOUNT_ID=pass://Ourio Release/Cloudflare/account_id
CLOUDFLARE_API_TOKEN=pass://Ourio Release/Cloudflare/api_token
# Prod has its own Apple keys (an APNs key restricted to Production and the topic com.ourio.app, and a
# Sign in with Apple key), in the item "Apple" of this vault; dev keeps its own in the vault "Ourio".
APNS_KEY=pass://Ourio Release/Apple/APNS_KEY
APNS_KEY_ID=pass://Ourio Release/Apple/APNS_KEY_ID
APPLE_SIGN_IN_KEY=pass://Ourio Release/Apple/APPLE_SIGN_IN_KEY
APPLE_SIGN_IN_KEY_ID=pass://Ourio Release/Apple/APPLE_SIGN_IN_KEY_ID
# The Cloudflare Access application in front of the prod /admin (docs/admin.md): its own
# application, so its own aud.
ACCESS_TEAM_DOMAIN=pass://Ourio Release/Cloudflare Access/team_domain
ACCESS_AUD=pass://Ourio Release/Cloudflare Access/aud
# TMDB's API read access token; without it prod serves no titles.
TMDB_TOKEN=pass://Ourio Release/TMDB/api_token
