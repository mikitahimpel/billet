# Optional, for a deploy: the AUD tag of the Access application that lets agents' service tokens
# read /admin/api/agent (docs/admin.md#agent-api). Add it to a deploy only once the field exists:
#   pp run --env-file .env.pass --env-file .env.pass.agent-access -- pnpm exec alchemy deploy --stage dev
# Without it the Worker gets no ACCESS_AGENT_AUD and the agent API stays closed; the panel is
# unaffected.
ACCESS_AGENT_AUD=pass://Billet/Cloudflare Access/agent_aud
