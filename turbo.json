{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "stream",
  "tasks": {
    "//#format:check:root": {
      "inputs": ["$TURBO_ROOT$/*", "$TURBO_ROOT$/.*", "$TURBO_ROOT$/docs/**"]
    },
    "//#lint:root": {
      "inputs": [
        "$TURBO_ROOT$/*",
        "$TURBO_ROOT$/.*",
        "$TURBO_ROOT$/packages/config/oxlint/oxlintrc.json"
      ]
    },
    "//#typecheck:root": {
      "inputs": [
        "$TURBO_ROOT$/*.ts",
        "$TURBO_ROOT$/tsconfig.json",
        "$TURBO_ROOT$/packages/config/typescript/*.json"
      ]
    },
    "format:check": {
      "dependsOn": ["//#format:check:root"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/.oxfmtrc.json"]
    },
    "ios:build": {
      "outputs": [],
      "inputs": [
        "Sources/**",
        "Tests/**",
        "Package.swift",
        "scripts/**",
        "$TURBO_ROOT$/.xcode-version",
        "$TURBO_ROOT$/.swift-format",
        "App/**",
        "Widget/**",
        "NotificationService/**",
        "project.yml"
      ]
    },
    "ios:format": {
      "cache": false
    },
    "ios:format:check": {
      "outputs": [],
      "inputs": [
        "Sources/**",
        "Tests/**",
        "Package.swift",
        "$TURBO_ROOT$/.xcode-version",
        "$TURBO_ROOT$/.swift-format",
        "App/**",
        "Widget/**",
        "NotificationService/**"
      ]
    },
    "ios:generate": {
      "outputs": [],
      "inputs": ["project.yml", "$TURBO_ROOT$/.xcode-version"]
    },
    "ios:test": {
      "outputs": [],
      "inputs": [
        "Sources/**",
        "Tests/**",
        "Package.swift",
        "scripts/**",
        "$TURBO_ROOT$/.xcode-version",
        "$TURBO_ROOT$/.swift-format"
      ]
    },
    "lint": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/.oxlintrc.json",
        "$TURBO_ROOT$/packages/config/oxlint/oxlintrc.json"
      ],
      "dependsOn": ["//#lint:root"]
    },
    "test": {
      "dependsOn": ["transit"],
      "inputs": ["$TURBO_DEFAULT$"]
    },
    "transit": {
      "dependsOn": ["^transit"]
    },
    "typecheck": {
      "dependsOn": ["transit", "//#typecheck:root"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/packages/config/typescript/*.json"]
    }
  }
}
