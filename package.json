{
  "name": "billet",
  "private": true,
  "type": "module",
  "scripts": {
    "lint": "turbo run lint",
    "format": "oxfmt .",
    "format:check": "turbo run format:check",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "ios:test": "turbo run ios:test",
    "ios:build": "turbo run ios:build",
    "format:check:root": "oxfmt --check . '!apps/**' '!packages/**'",
    "alchemy": "alchemy",
    "typecheck:root": "tsc --noEmit -p tsconfig.json",
    "lint:root": "oxlint --ignore-pattern 'apps/**' --ignore-pattern 'packages/**' ."
  },
  "devDependencies": {
    "@alchemy.run/cloudflare": "catalog:",
    "@effect/platform-node": "catalog:infra",
    "@types/node": "catalog:",
    "alchemy": "catalog:",
    "effect": "catalog:infra",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@10.30.3"
}
