# Optional, for a deploy: a Cloudflare API token that can only read Account Analytics, so the admin
# panel's trends read Analytics Engine for the last 90 days (docs/admin.md#trends-explorer). Add it
# to a deploy only once the item exists:
#   pp run --env-file .env.pass --env-file .env.pass.analytics-read -- pnpm exec alchemy deploy --stage dev
# Without it the Worker gets no ANALYTICS_READ_TOKEN and the trends use D1 alone.
ANALYTICS_READ_TOKEN=pass://Billet/cloudflare-analytics/api_token
