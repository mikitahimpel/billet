    "./admin-overview": "./src/admin-overview.ts",
    "./admin-retention": "./src/admin-retention.ts",
    "./admin-routes": "./src/admin-routes.ts",
    "./admin-trends": "./src/admin-trends.ts",
    "./analytics-engine-reader": "./src/analytics-engine-reader.ts",
