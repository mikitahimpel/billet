{
  "name": "@billet/backend-platform",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "exports": {
    "./admin-data-live": "./src/admin-data-live.ts",
    "./admin-fetch": "./src/admin-fetch.ts",
    "./api-fetch": "./src/api-fetch.ts",
    "./app-status-live": "./src/app-status-live.ts",
    "./apple-identity-live": "./src/apple-identity-live.ts",
    "./maintenance-gate": "./src/maintenance-gate.ts",
    "./auth-repository-live": "./src/auth-repository-live.ts",
    "./demo-room-durable-object": "./src/demo-room-durable-object.ts",
    "./demo-route": "./src/demo-route.ts",
    "./directory-database": "./src/directory-database.ts",
    "./directory-schema": "./src/directory-schema.ts",
    "./event-sink-live": "./src/event-sink-live.ts",
    "./flag-config-repository-live": "./src/flag-config-repository-live.ts",
    "./flags-repository-live": "./src/flags-repository-live.ts",
    "./media-store-live": "./src/media-store-live.ts",
    "./metrics-repository-live": "./src/metrics-repository-live.ts",
    "./pair-room-durable-object": "./src/pair-room-durable-object.ts",
    "./pair-rooms-live": "./src/pair-rooms-live.ts",
    "./pair-variants-live": "./src/pair-variants-live.ts",
    "./pairing-repository-live": "./src/pairing-repository-live.ts",
    "./placeholder-fetch": "./src/placeholder-fetch.ts",
    "./room-database": "./src/room-database.ts",
    "./room-schema": "./src/room-schema.ts",
    "./worker-env": "./src/worker-env.ts"
  },
  "scripts": {
    "lint": "oxlint .",
    "format:check": "oxfmt --check .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate --dialect sqlite --schema ./src/directory-schema.ts --out ./migrations/directory && drizzle-kit generate --dialect sqlite --driver durable-sqlite --schema ./src/room-schema.ts --out ./migrations/room"
  },
  "dependencies": {
    "@better-auth/kysely-adapter": "catalog:",
    "@billet/backend-admin": "workspace:*",
    "@billet/backend-auth": "workspace:*",
    "@billet/backend-flags": "workspace:*",
    "@billet/backend-metrics": "workspace:*",
    "@billet/backend-notes": "workspace:*",
    "@billet/backend-pair-room": "workspace:*",
    "@billet/backend-pairing": "workspace:*",
    "@billet/contracts-domain": "workspace:*",
    "@billet/contracts-http-api": "workspace:*",
    "@billet/contracts-realtime": "workspace:*",
    "@effect/sql-d1": "catalog:",
    "@effect/sql-sqlite-do": "catalog:",
    "better-auth": "catalog:",
    "drizzle-orm": "catalog:",
    "effect": "catalog:",
    "kysely": "catalog:"
  },
  "devDependencies": {
    "@alchemy.run/sql": "catalog:",
    "@billet/config-typescript": "workspace:*",
    "@cloudflare/vitest-pool-workers": "catalog:",
    "@cloudflare/workers-types": "catalog:",
    "drizzle-kit": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
