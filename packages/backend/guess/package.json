{
  "name": "@billet/backend-guess",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "exports": {
    "./guess-catalog-routes": "./src/guess-catalog-routes.ts",
    "./question-catalog": "./src/question-catalog.ts",
    "./question-catalog.json": "./src/question-catalog.json"
  },
  "scripts": {
    "lint": "oxlint .",
    "format:check": "oxfmt --check .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "catalog:version": "node scripts/question-catalog-version.mjs && oxfmt src/question-catalog.json"
  },
  "dependencies": {
    "@billet/contracts-domain": "workspace:*",
    "@billet/contracts-http-api": "workspace:*",
    "effect": "catalog:"
  },
  "devDependencies": {
    "@billet/config-typescript": "workspace:*",
    "@cloudflare/workers-types": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
