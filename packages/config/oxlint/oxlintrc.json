{
  "$schema": "../../../node_modules/oxlint/configuration_schema.json",
  "plugins": ["eslint", "typescript", "unicorn", "oxc", "import"],
  "categories": {
    "correctness": "error"
  },
  "rules": {
    "unicorn/filename-case": ["error", { "case": "kebabCase" }],
    "import/no-cycle": "error",
    "import/no-default-export": "error"
  }
}
