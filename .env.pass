# Proton Pass references for the `dev` stage (vault "Billet"). Never put real values here.
# Run: PROTON_PASS_AGENT_REASON="<reason>" pp run --env-file .env.pass -- pnpm exec alchemy deploy --stage dev
# Do not pass --env-file to alchemy itself: with that flag the file beats the shell and Alchemy would
# read the literal pass:// strings. See docs/alchemy.md.
#
# The vault "Billet" exists and holds the "Apple" item. The "cloudflare" item is still planned.
# Item titles must match exactly (case-sensitive).
CLOUDFLARE_ACCOUNT_ID=pass://Billet/cloudflare/account_id
CLOUDFLARE_API_TOKEN=pass://Billet/cloudflare/api_token
APNS_KEY=pass://Billet/Apple/APNS_KEY
APNS_KEY_ID=pass://Billet/Apple/APNS_KEY_ID
APPLE_SIGN_IN_KEY=pass://Billet/Apple/APPLE_SIGN_IN_KEY
APPLE_SIGN_IN_KEY_ID=pass://Billet/Apple/APPLE_SIGN_IN_KEY_ID
# The Cloudflare Access application in front of /admin (docs/admin.md). Item "cloudflare-access"
# is planned. Not secret, but kept out of the public repo. Empty or missing keeps /admin closed.
ACCESS_TEAM_DOMAIN=pass://Billet/cloudflare-access/team_domain
ACCESS_AUD=pass://Billet/cloudflare-access/aud
# The second Access application, for agents' service tokens on /admin/api/agent. pp needs the field
# to exist (leave it empty until that application exists); empty keeps the agent API closed and the
# panel unaffected.
ACCESS_AGENT_AUD=pass://Billet/cloudflare-access/agent_aud
