{/* Self-hosted Umami: no cookies, no IP stored; counts only on ourio.app, not on pages.dev previews.
    umami-filter.js drops headless renders and must run first (defer keeps the order). */}
<script is:inline defer src="/umami-filter.js"></script>
<script is:inline defer src="https://stats.itsnexis.com/s.js" data-website-id="602fa9cd-5bb9-4de9-bc6d-bcdcce04c264" data-domains="ourio.app" data-before-send="umamiBeforeSend" data-auto-pageview="false"></script>
{/* GA4 in its own Ourio account (G-L3WKKDKMSB), with no cookie box: it loads only where it needs no consent. Not in the
    EEA, the UK or Switzerland, not under Global Privacy Control, and not for the owner's devices; those visits are
    counted by Umami alone. Ads storage is always denied. Links that carry data-umami-event (App Store buttons) send
    the same event to GA4. gtag stays a no-op where GA4 is off, so pages can call it without checking. */}
<script is:inline>
  window.dataLayer = window.dataLayer || [];
  window.gtag = function () { dataLayer.push(arguments); };
  (function () {
    // ?notrack=1 (or ?notrack=0) on any page turns both counters off (or on) for this browser; Umami reads the same key.
    const flag = new URLSearchParams(location.search).get('notrack');
    try {
      if (flag === '1') localStorage.setItem('umami.disabled', '1');
      if (flag === '0') localStorage.removeItem('umami.disabled');
      if (localStorage.getItem('umami.disabled')) return;
    } catch {}
    // note: the time zone stands in for the country, since a static page has no geo header. A European on a US time
    // zone gets GA4 and a visitor on a European one doesn't; the upgrade path is a Pages Function that reads cf.country.
    const zone = Intl.DateTimeFormat().resolvedOptions().timeZone || '';
    if (/^(Europe|Arctic)\/|^Atlantic\/(Azores|Canary|Faroe|Madeira|Reykjavik)$|^Africa\/Ceuta$/.test(zone)) return;
    if (navigator.globalPrivacyControl) return;
    // pages.dev previews and local builds stay out of the property.
    if (location.hostname !== 'ourio.app') return;
    gtag('consent', 'default', { ad_storage: 'denied', ad_user_data: 'denied', ad_personalization: 'denied', analytics_storage: 'granted' });
    gtag('js', new Date());
    gtag('config', 'G-L3WKKDKMSB', { allow_google_signals: false, allow_ad_personalization_signals: false });
    const s = document.createElement('script');
    s.async = true;
    s.src = 'https://www.googletagmanager.com/gtag/js?id=G-L3WKKDKMSB';
    document.head.appendChild(s);
    document.addEventListener('click', function (e) {
      const a = e.target instanceof Element && e.target.closest('[data-umami-event]');
      if (a) gtag('event', a.dataset.umamiEvent, { where: a.dataset.umamiEventWhere || location.pathname, transport_type: 'beacon' });
    });
  })();
</script>
