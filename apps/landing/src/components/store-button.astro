---
import { appStoreLive, appStoreUrl } from "../config";
---

{
  appStoreLive ? (
    <a class="store" href={appStoreUrl} data-umami-event="app_store_click" data-umami-event-where="store_button">
      <svg viewBox="0 0 17 20" aria-hidden="true">
        <use href="#apple" />
      </svg>
      Download on the App Store
    </a>
  ) : (
    <span class="store" role="link" aria-disabled="true">
      <svg viewBox="0 0 17 20" aria-hidden="true">
        <use href="#apple" />
      </svg>
      Coming soon to the App Store
    </span>
  )
}
