---
type Props = { n: number; title: string; body: string };
const { n, title, body } = Astro.props;
---

<span class="mt-6 font-mono text-label text-honey tabular-nums">{String(n).padStart(2, "0")}</span>
<h3 class="mt-2 text-h3">{title}</h3>
<p class="mt-3 max-w-[24rem] text-body text-soft">{body}</p>
