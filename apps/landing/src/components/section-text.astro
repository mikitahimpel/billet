---
import type { FeatureSection } from "../features";

interface Props {
  section: FeatureSection;
}

const { section } = Astro.props;
---

<div class="txt">
  <h2 class="pg-h2">{section.heading}</h2>
  {section.body.map((paragraph) => <p>{paragraph}</p>)}
  {
    section.bullets && (
      <ul class="dots">
        {section.bullets.map((bullet) => (
          <li>{bullet}</li>
        ))}
      </ul>
    )
  }
  {
    section.table && (
      <div class="tbl">
        <table>
          <caption class="sr-only">{section.table.caption}</caption>
          <thead>
            <tr>
              {section.table.head.map((cell) => (
                <th scope="col">{cell}</th>
              ))}
            </tr>
          </thead>
          <tbody>
            {section.table.rows.map(([first, ...rest]) => (
              <tr>
                <th scope="row">{first}</th>
                {rest.map((cell) => (
                  <td>{cell}</td>
                ))}
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    )
  }
</div>
