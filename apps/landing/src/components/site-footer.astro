---
import { appStoreLive, appStoreUrl } from "../config";
import { features, pages } from "../site";

const page = (path: string) => pages.find((candidate) => candidate.path === path)!;
const feature = (slug: string) => page(`/features/${slug}/`);
const planner = ["us", "date-night", "wishlists", "shared-lists", "movie-night", "calendar-and-countdown"];
const groups = [
  {
    title: "Features",
    links: [
      page("/features/"),
      ...features.filter((link) => !planner.some((slug) => link.path === `/features/${slug}/`)),
    ],
  },
  { title: "Planner", links: planner.map(feature) },
  {
    title: "Compare",
    links: [
      page("/long-distance-relationship-app/"),
      page("/free-couples-app/"),
      ...pages.filter((link) => link.group === "compare"),
    ],
  },
  {
    title: "Help",
    links: [
      ...pages.filter((link) => link.group === "help" || link.group === "legal"),
      { path: "/llms.txt", label: "llms.txt" },
    ],
  },
];
---

<footer class="border-t border-paper/10">
  <div class="container-page grid gap-10 pt-14 pb-28 lg:grid-cols-[minmax(0,3fr)_minmax(0,9fr)] lg:pb-14">
    <div>
      <a href="/" class="text-[1.375rem] font-black tracking-[-0.03em]">Ourio</a>
      <p class="mt-2 max-w-[24rem] text-small text-muted">
        A free iPhone app for couples: one shared room, one cat, and everything you do for her on your partner's Lock
        Screen.
      </p>
      {
        appStoreLive ? (
          <a href={appStoreUrl} class="mt-5 inline-block rounded-full bg-gold px-5 py-2.5 text-small font-extrabold text-ink" data-cta>
            Get Ourio for iPhone
          </a>
        ) : (
          <p class="mt-5 inline-block rounded-full bg-gold px-5 py-2.5 text-small font-extrabold text-ink">Coming soon to iPhone</p>
        )
      }
    </div>
    <nav class="grid grid-cols-2 gap-x-6 gap-y-8 md:grid-cols-4" aria-label="Footer">
      {
        groups.map((group) => (
          <div>
            <p class="eyebrow">{group.title}</p>
            <ul class="mt-3 space-y-1.5 text-small text-muted">
              {group.links.map((link) => (
                <li>
                  <a href={link.path} class="underline-offset-4 hover:text-paper hover:underline">
                    {link.label}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </nav>
  </div>
  <div class="container-page border-t border-paper/10 py-6 text-label text-muted">© 2026 Ourio. iPhone only, US English.</div>
</footer>
