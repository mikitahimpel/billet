---
import { Image } from "astro:assets";
import mochi from "../assets/MochiPortrait.png";
import AppStoreBadge from "./app-store-badge.astro";

interface Props {
  title?: string;
}

const { title = "Move in together." } = Astro.props;
---

<section class="relative section-y">
  <div class="lamp-glow absolute inset-x-0 top-0 mx-auto h-[28rem] max-w-2xl" aria-hidden="true"></div>
  <div class="container-page relative flex flex-col items-center text-center">
    <Image src={mochi} alt="" widths={[192, 384]} sizes="192px" class="w-40 [mask-image:linear-gradient(#000_70%,transparent)] md:w-48" />
    <h2 class="mt-2 max-w-[14ch] text-h2">{title}</h2>
    <p class="mt-5 max-w-[30rem] text-lead text-soft">Ourio is free on iPhone. Your partner joins with one code.</p>
    <AppStoreBadge qr class="mt-8" />
  </div>
</section>
