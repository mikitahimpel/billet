---
import { getImage } from "astro:assets";
import { dateIdeas, fanCards } from "../dates";
import type { Feature, FeatureSection } from "../features";
import Page from "../layouts/page.astro";
import { features, pages } from "../site";
import Art from "./art.astro";
import EndCard from "./end-card.astro";
import SectionText from "./section-text.astro";
import StoreButton from "./store-button.astro";

interface Props {
  feature: Feature;
}

const { feature } = Astro.props;
// Sections with a picture get a row of their own, alternating sides; runs of text-only sections sit side by side as columns.
type Block = { kind: "row"; section: FeatureSection; flip: boolean } | { kind: "cols"; sections: FeatureSection[] };
const blocks: Block[] = [];
let rows = 0;
for (const section of feature.sections) {
  const last = blocks.at(-1);
  if (section.picture) blocks.push({ kind: "row", section, flip: rows++ % 2 === 1 });
  else if (last?.kind === "cols") last.sections.push(section);
  else blocks.push({ kind: "cols", sections: [section] });
}
// A related slug is a feature page or a use-case page at the site root.
const others = feature.related
  ? feature.related.map(
      (slug) => pages.find((page) => page.path === `/features/${slug}/` || page.path === `/${slug}/`)!,
    )
  : features.filter((page) => page.path !== Astro.url.pathname);
const schema: Record<string, unknown>[] = [
  {
    "@type": "FAQPage",
    mainEntity: feature.questions.map((item) => ({
      "@type": "Question",
      name: item.question,
      acceptedAnswer: { "@type": "Answer", text: item.answer },
    })),
  },
];
if (feature.steps)
  schema.push({
    "@type": "HowTo",
    name: feature.h1,
    step: feature.steps.map((step, i) => ({ "@type": "HowToStep", position: i + 1, name: step.title, text: step.text })),
  });

const ideas =
  feature.gallery === "dates"
    ? await Promise.all(
        dateIdeas.map(async (idea) => ({
          idea,
          small: (await getImage({ src: idea.art, width: 400, format: "webp" })).src,
        })),
      )
    : [];
// The hand of cards fans from -12° to 12°, the outer ones lower.
const fan =
  feature.gallery === "dates"
    ? await Promise.all(
        fanCards.map(async (art, i) => ({
          art,
          small: (await getImage({ src: art, width: 400, format: "webp" })).src,
          style: `--r: ${(i - 2) * 6}deg; --y: ${[26, 8, 0, 8, 26][i]}px`,
        })),
      )
    : [];
---

<Page title={feature.title} description={feature.description} schema={schema} bodyClass="site-feature">
  <section class="wrap pg-hero">
    <div class="pg-hero-copy">
      <p class="eyebrow">{feature.eyebrow}</p>
      <h1>{feature.h1}</h1>
      <p class="lead">{feature.lead}</p>
      <div class="pg-cta"><StoreButton /></div>
    </div>
    <Art picture={feature.hero} class="pg-hero-art" eager fitHeight="34rem" />
  </section>
  {
    feature.steps && (
      <section class="pg wrap" aria-labelledby="how">
        <h2 id="how" class="pg-h2">
          How it works
        </h2>
        <ol class={`pg-steps n${feature.steps.length} reveal`}>
          {feature.steps.map((step, i) => (
            <li>
              <span class="step-n" aria-hidden="true">
                {String(i + 1).padStart(2, "0")}
              </span>
              <h3>{step.title}</h3>
              <p>{step.text}</p>
            </li>
          ))}
        </ol>
        {fan.length > 0 && (
          <ul class="fan reveal" aria-hidden="true">
            {fan.map(({ art, small, style }) => (
              <li style={style}>
                <img
                  src={small}
                  srcset={`${small} 400w, ${art.src} ${art.width}w`}
                  sizes="(max-width: 640px) 30vw, 200px"
                  alt=""
                  width={art.width}
                  height={art.height}
                  loading="lazy"
                  decoding="async"
                />
              </li>
            ))}
          </ul>
        )}
      </section>
    )
  }
  {
    blocks.map((block) =>
      block.kind === "row" ? (
        <section id={block.section.id} class:list={["pg wrap pg-row", block.flip && "flip"]}>
          <SectionText section={block.section} />
          <Art picture={block.section.picture!} class="reveal" fitHeight="30rem" />
        </section>
      ) : (
        <div class:list={["pg wrap pg-cols", block.sections.length === 1 && "one"]}>
          {block.sections.map((section, i) => (
            <section
              id={section.id}
              class:list={[
                "pg-col",
                block.sections.length > 1 && block.sections.length % 2 === 1 && i === block.sections.length - 1 && "span",
              ]}
            >
              <SectionText section={section} />
            </section>
          ))}
        </div>
      ),
    )
  }
  {
    ideas.length > 0 && (
      <section class="pg wrap" aria-labelledby="ideas-gallery">
        <h2 id="ideas-gallery" class="pg-h2">
          A few of the 150 ideas
        </h2>
        <ul class="ideas">
          {ideas.map(({ idea, small }) => (
            <li class="reveal">
              <figure class="idea-art">
                <img
                  src={idea.art.src}
                  srcset={`${small} 400w, ${idea.art.src} ${idea.art.width}w`}
                  sizes="(max-width: 640px) 44vw, 280px"
                  alt=""
                  width={idea.art.width}
                  height={idea.art.height}
                  loading="lazy"
                  decoding="async"
                />
              </figure>
              <h3>{idea.title}</h3>
              <p>{idea.pitch}</p>
              <p class="idea-meta">
                {idea.place} · {idea.cost}
              </p>
            </li>
          ))}
        </ul>
      </section>
    )
  }
  <section class="pg wrap pg-split" aria-labelledby="questions">
    <div class="qs-side">
      <h2 id="questions" class="pg-h2">Questions</h2>
      <p class="pg-note">More answers in the <a href="/faq/">FAQ</a> and the <a href="/help/">help pages</a>.</p>
    </div>
    <div>
      <div class="qs">
        {
          feature.questions.map((item) => (
            <details open>
              <summary>
                <h3>{item.question}</h3>
                <span class="plus" aria-hidden="true" />
              </summary>
              <p>{item.answer}</p>
            </details>
          ))
        }
      </div>
    </div>
  </section>
  <section class="pg wrap" aria-labelledby="more">
    <h2 id="more" class="pg-h2">More of Ourio</h2>
    <ul class="more">
      {
        others.map((page) => (
          <li>
            <a href={page.path}>
              <span class="more-name">{page.label}</span>
              <span class="more-sum">{page.summary}</span>
              <span class="more-go" aria-hidden="true">
                →
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>
  <EndCard />
</Page>
