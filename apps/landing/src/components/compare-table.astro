---
import { capabilities, checked, type App } from "../compare";

interface Props {
  apps: App[];
  caption: string;
}

const { apps, caption } = Astro.props;
// Each date the shown apps were read on, oldest first, naming the apps when there is more than one date.
const read = apps.filter((app) => app.sources.length);
const dates = [...new Map(read.map((app) => [(app.checked ?? checked).iso, app.checked ?? checked])).values()]
  .sort((a, b) => a.iso.localeCompare(b.iso))
  .map((date) => ({ ...date, names: read.filter((app) => (app.checked ?? checked).iso === date.iso).map((app) => app.name) }));
---

<div class="tbl tbl-wide">
  <table>
    <caption>
      {caption} ✓ means the app's App Store page or website lists it; a dash means we didn't find it listed. Checked {
        dates.map((date, i) => (
          <>
            {i > 0 && "; "}
            <time datetime={date.iso}>{date.label}</time>
            {dates.length > 1 && ` (${date.names.join(", ")})`}
          </>
        ))
      }.
    </caption>
    <thead>
      <tr>
        <td></td>
        {apps.map((app) => <th scope="col">{app.name}</th>)}
      </tr>
    </thead>
    <tbody>
      <tr>
        <th scope="row">Price</th>
        {apps.map((app) => <td>{app.price}</td>)}
      </tr>
      <tr>
        <th scope="row">Android</th>
        {apps.map((app) => <td>{app.android ? "Yes" : "No, iPhone only"}</td>)}
      </tr>
      {
        capabilities.map((capability) => (
          <tr>
            <th scope="row">{capability.label}</th>
            {apps.map((app) =>
              app.has.includes(capability.key) ? <td class="yes">✓</td> : <td>–</td>,
            )}
          </tr>
        ))
      }
      <tr>
        <th scope="row">App Store rating</th>
        {apps.map((app) => <td>{app.rating}</td>)}
      </tr>
    </tbody>
  </table>
</div>
