---
// Their lock screen in a phone: the date and time, one notification from Ourio, and with `full` the status
// bar, the torch and camera buttons and (with `widgets`) Mochi's and the day-count widgets under the clock.
import { getImage } from "astro:assets";
import mochi from "../assets/mochi-portrait.webp";
import Notification from "./notification.astro";
import StatusBar from "./status-bar.astro";

interface Props {
  line: string;
  full?: boolean;
  widgets?: boolean;
}

const { line, full = false, widgets = false } = Astro.props;
const portrait = await Promise.all(
  [96, 192, 320].map(async (width) => ({ width, url: (await getImage({ src: mochi, width, format: "webp" })).src })),
);
---

<div class="phone">
  <div class="screen lock">
    {full && <StatusBar />}
    <span class="island"></span>
    <div class="lock-top">
      <p class="lock-date">Thursday 5 November</p>
      <p class="lock-time">9:41</p>
      {
        widgets && (
          <div class="lock-widgets">
            <span class="lw-round">
              <img
                src={portrait[0]!.url}
                srcset={portrait.map((step) => `${step.url} ${step.width}w`).join(", ")}
                sizes="56px"
                alt=""
                width="56"
                height="56"
                loading="lazy"
                decoding="async"
              />
            </span>
            <span class="lw-rect"><b>Ourio</b><span class="day">Day 127</span></span>
          </div>
        )
      }
    </div>
    <Notification line={line} />
    {full && <span class="lock-btn lock-torch" />}
    {full && <span class="lock-btn lock-cam" />}
    <span class="home-bar"></span>
  </div>
</div>
