---
import icon from "../assets/app-icon-192b.webp?url";

interface Props {
  // The home page's header is fixed: the story's clear header row over the story, then a compact bar once the story
  // has scrolled past (main.js sets .compact), with the pill linking to the end card's app card.
  home?: boolean;
}

const { home = false } = Astro.props;
const current = Astro.url.pathname;
const links = [
  { href: "/features/", label: "Features" },
  { href: "/how-it-works/", label: "How it works" },
  { href: "/faq/", label: "FAQ" },
  { href: "/help/", label: "Help" },
];
---

<header class:list={["chrome", home ? "home-chrome" : "page-chrome"]} id="chrome" data-md={home ? "skip" : undefined}>
  <a class="mark" href="/" aria-label="Ourio">
    <img src={icon} alt="" width="64" height="64" decoding="async" />
    <span>Ourio</span>
  </a>
  <nav class="nav" aria-label="Main">
    {
      links.map((link) => (
        <a href={link.href} aria-current={current.startsWith(link.href) ? "page" : undefined}>
          {link.label}
        </a>
      ))
    }
  </nav>
  {home ? <a class="nav-soon" href="#get">Coming soon</a> : <span class="nav-soon">Coming soon</span>}
  <details class="menu">
    <summary aria-label="Menu">
      <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M3 6h14M3 10h14M3 14h14"></path></svg>
    </summary>
    <nav class="menu-panel" aria-label="Main">
      {links.map((link) => <a href={link.href}>{link.label}</a>)}
      <a href="/support/">Support</a>
    </nav>
  </details>
</header>
