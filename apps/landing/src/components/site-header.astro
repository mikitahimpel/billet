---
import { getImage } from "astro:assets";
import appIcon from "../assets/app-icon.png";

interface Props {
  // On the home page the header is the first row of the pinned story; elsewhere it sits on the page.
  home?: boolean;
}

const { home = false } = Astro.props;
const current = Astro.url.pathname;
const icon = await getImage({ src: appIcon, width: 192, format: "webp" });
const links = [
  { href: "/features/", label: "Features" },
  { href: "/how-it-works/", label: "How it works" },
  { href: "/faq/", label: "FAQ" },
  { href: "/help/", label: "Help" },
];
---

<header class:list={["chrome", !home && "page-chrome"]} id="chrome" data-md={home ? "skip" : undefined}>
  <a class="mark" href="/" aria-label="Ourio">
    <img src={icon.src} alt="" width="64" height="64" decoding="async" />
    <span>Ourio</span>
  </a>
  <nav class="nav" aria-label="Main">
    {
      links.map((link) => (
        <a href={link.href} aria-current={current.startsWith(link.href) ? "page" : undefined}>
          {link.label}
        </a>
      ))
    }
  </nav>
  <span class="nav-soon">Coming soon</span>
  <details class="menu">
    <summary aria-label="Menu">
      <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M3 6h14M3 10h14M3 14h14"></path></svg>
    </summary>
    <nav class="menu-panel" aria-label="Main">
      {links.map((link) => <a href={link.href}>{link.label}</a>)}
      <a href="/support/">Support</a>
    </nav>
  </details>
</header>
