---
import { getImage } from "astro:assets";
import QRCode from "qrcode";
import appIcon from "../assets/app-icon.png";
import { appStoreUrl } from "../config";

type Props = { class?: string };
const { class: className } = Astro.props;

// Level H survives the icon covering the centre (up to 30% of the modules can be lost).
const { modules } = QRCode.create(appStoreUrl, { errorCorrectionLevel: "H" });
const size = modules.size;
const quiet = 2;
const icon = await getImage({ src: appIcon, width: 96, format: "webp" });

const eyes = [
  [0, 0],
  [size - 7, 0],
  [0, size - 7],
] as const;
const inEye = (x: number, y: number) => eyes.some(([ex, ey]) => x >= ex && x < ex + 7 && y >= ey && y < ey + 7);
const hole = Math.ceil(size * 0.24) | 1;
const holeStart = (size - hole) / 2;
const inHole = (x: number, y: number) =>
  x >= holeStart - 0.5 && x < holeStart + hole + 0.5 && y >= holeStart - 0.5 && y < holeStart + hole + 0.5;

const dots: { x: number; y: number }[] = [];
for (let y = 0; y < size; y++) {
  for (let x = 0; x < size; x++) {
    if (modules.get(y, x) && !inEye(x, y) && !inHole(x, y)) dots.push({ x: x + 0.5, y: y + 0.5 });
  }
}
const box = size + quiet * 2;
// The page renders this more than once, and clip-path ids are document-wide.
const clipId = `qr-icon-${crypto.randomUUID().slice(0, 8)}`;
---

<svg
  viewBox={`${-quiet} ${-quiet} ${box} ${box}`}
  class={className}
  role="img"
  aria-label="QR code that opens Ourio on the App Store"
>
  <rect x={-quiet} y={-quiet} width={box} height={box} rx={quiet * 1.6} fill="#fbf3e6"></rect>
  <g fill="#2a1208">
    {dots.map((dot) => <circle cx={dot.x} cy={dot.y} r="0.43" />)}
  </g>
  {
    eyes.map(([x, y]) => (
      <g>
        <rect x={x + 0.5} y={y + 0.5} width="6" height="6" rx="2" fill="none" stroke="#2a1208" stroke-width="1" />
        <rect x={x + 2} y={y + 2} width="3" height="3" rx="1.1" fill="#8a3a14" />
      </g>
    ))
  }
  <clipPath id={clipId}>
    <rect x={holeStart} y={holeStart} width={hole} height={hole} rx={hole * 0.22}></rect>
  </clipPath>
  <image href={icon.src} x={holeStart} y={holeStart} width={hole} height={hole} clip-path={`url(#${clipId})`}></image>
</svg>
