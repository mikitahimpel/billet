---
import SiteFooter from "../components/site-footer.astro";
import SiteHeader from "../components/site-header.astro";
import SiteScript from "../components/site-script.astro";
import { appStoreId } from "../config";
import bricolage from "../assets/fonts/bricolage-grotesque-latin.woff2?url";
import nunito from "../assets/fonts/nunito-latin.woff2?url";
import { pages } from "../site";
import criticalHome from "../styles/critical-home.css?raw";
import criticalSite from "../styles/critical-site.css?raw";
import sheet from "../styles/global.css?url";

interface Props {
  title: string;
  description: string;
  // Shorter title and line for link previews; the page title and description otherwise.
  shareTitle?: string;
  shareDescription?: string;
  // Extra schema.org nodes for this page; WebPage and its breadcrumb are added here.
  schema?: Record<string, unknown>[];
  // The home page brings its own header (inside the story), first-screen styles and scripts.
  home?: boolean;
  // A class per page template on <body>: site-feature, site-faq, site-doc...
  bodyClass?: string;
  // Kept out of search, the sitemap and the Markdown twins.
  noindex?: boolean;
}

const {
  title,
  description,
  shareTitle = title,
  shareDescription = description,
  schema = [],
  home = false,
  bodyClass,
  noindex = false,
} = Astro.props;
const path = Astro.url.pathname;
// A ?raw import keeps the critical sheets' url()s as written, so their font paths become the hashed build URLs here.
const critical = (home ? criticalHome : criticalSite)
  .replaceAll("../assets/fonts/bricolage-grotesque-latin.woff2", bricolage)
  .replaceAll("../assets/fonts/nunito-latin.woff2", nunito);
const canonical = new URL(path, Astro.site).href;
const ogImage = new URL("/og.png", Astro.site).href;
const homeUrl = new URL("/", Astro.site).href;

// The trail from home to this page, from the site's own page list: /features/games/ → Home › All features › Games.
const trail = path
  .split("/")
  .filter(Boolean)
  .map((_, i, parts) => `/${parts.slice(0, i + 1).join("/")}/`)
  .map((p) => pages.find((page) => page.path === p))
  .filter((page) => page !== undefined);

const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebPage",
      "@id": `${canonical}#page`,
      url: canonical,
      name: title,
      description,
      inLanguage: "en-US",
      isPartOf: { "@id": `${homeUrl}#website` },
      about: { "@id": `${homeUrl}#app` },
    },
    ...(trail.length > 0
      ? [
          {
            "@type": "BreadcrumbList",
            itemListElement: [{ path: "/", label: "Home" }, ...trail].map((page, i) => ({
              "@type": "ListItem",
              position: i + 1,
              name: page.label,
              item: new URL(page.path, Astro.site).href,
            })),
          },
        ]
      : []),
    ...schema,
  ],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#0a0605" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    {!noindex && <meta name="robots" content="index, follow, max-image-preview:large" />}

    <link rel="icon" href="/favicon.png" type="image/png" sizes="48x48" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    {!noindex && <link rel="alternate" type="text/markdown" href={`${path}index.md`} />}
    {appStoreId && <meta name="apple-itunes-app" content={`app-id=${appStoreId}`} />}

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Ourio" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={shareTitle} />
    <meta property="og:description" content={shareDescription} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Mochi, a grey tabby kitten, beside the words: Your love has a cat now." />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={shareTitle} />
    <meta name="twitter:description" content={shareDescription} />
    <meta name="twitter:image" content={ogImage} />

    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
    <slot name="head" />
    <link rel="preload" href={bricolage} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={nunito} as="font" type="font/woff2" crossorigin />
    <!-- The first screen's rules (a subset of global.css); the whole sheet loads without blocking the paint. -->
    <style is:inline set:html={critical} />
    <link rel="stylesheet" href={sheet} media="print" onload="this.media='all'" data-sheet />
    <noscript><link rel="stylesheet" href={sheet} /></noscript>
    <script is:inline>
      // Hidden-before-entrance states hang off this class only. It comes off again if a script
      // throws, or if the page script hasn't started within 4 s (blocked or failed to load).
      (function () {
        var html = document.documentElement;
        var off = function () {
          html.classList.remove("js");
        };
        html.classList.add("js");
        addEventListener("error", off);
        setTimeout(function () {
          if (!html.classList.contains("js-ready")) off();
        }, 4000);
      })();
    </script>
  </head>
  <body class:list={[!home && "site", bodyClass]}>
    {!home && <SiteHeader />}
    <main>
      {
        trail.length > 0 && (
          <nav class="wrap crumbs" aria-label="Breadcrumb">
            <ol>
              <li>
                <a href="/">Home</a>
              </li>
              {trail.map((page) => (
                <li>
                  {page.path === path ? <span aria-current="page">{page.label}</span> : <a href={page.path}>{page.label}</a>}
                </li>
              ))}
            </ol>
          </nav>
        )
      }
      <slot />
    </main>
    <SiteFooter />
    <div class="grain" aria-hidden="true"></div>
    <svg width="0" height="0" style="position: absolute" aria-hidden="true">
      <symbol id="apple" viewBox="0 0 17 20">
        <path
          d="M14.1 10.6c0-2.5 2-3.7 2.1-3.8-1.2-1.7-3-1.9-3.6-2-1.5-.2-3 .9-3.8.9-.8 0-2-.9-3.3-.9C3.8 4.9 2.2 5.9 1.3 7.4c-1.8 3.2-.5 7.9 1.3 10.5.9 1.3 1.9 2.7 3.2 2.6 1.3-.1 1.8-.8 3.3-.8s2 .8 3.3.8c1.4 0 2.3-1.3 3.1-2.6 1-1.5 1.4-2.9 1.4-3-.1 0-2.8-1.1-2.8-4.3ZM11.6 3.2c.7-.9 1.2-2 1.1-3.2-1 0-2.3.7-3 1.6-.7.8-1.3 2-1.1 3.1 1.1.1 2.3-.6 3-1.5Z"
        ></path>
      </symbol>
    </svg>
    {!home && <SiteScript />}
    <slot name="after" />
  </body>
</html>
