---
import EndCard from "../components/end-card.astro";
import { questions, type Question } from "../faq";
import Page from "../layouts/page.astro";

const topics = [...new Set(questions.map((item) => item.topic))] satisfies Question["topic"][];
const schema = [
  {
    "@type": "FAQPage",
    mainEntity: questions.map((item) => ({
      "@type": "Question",
      name: item.question,
      acceptedAnswer: { "@type": "Answer", text: item.answer },
    })),
  },
];
---

<Page
  title="Ourio FAQ: price, pairing, privacy and features of the couples app"
  description="Answers about Ourio, the free iPhone app for couples: what it costs, what you need, how pairing works, widgets, games, coins, privacy and deleting your account."
  schema={schema}
  bodyClass="site-faq"
>
  <section class="wrap pg-faq">
    <div class="faq-grid">
      <div class="faq-side">
        <p class="eyebrow">FAQ</p>
        <h1>Questions about Ourio</h1>
        <p class="lead">
          Ourio is a free iPhone app for couples with a shared room and a cat. Can't find your answer? See <a
            href="/help/">Help</a
          > or <a href="/support/">contact support</a>.
        </p>
        <nav class="chips" aria-label="Topics">
          {topics.map((topic) => <a href={`#${topic.toLowerCase()}`}>{topic}</a>)}
        </nav>
      </div>
      <div>
        {
          topics.map((topic) => (
            <section id={topic.toLowerCase()} class="faq-topic">
              <h2 class="eyebrow">{topic}</h2>
              <div class="qs">
                {questions
                  .filter((item) => item.topic === topic)
                  .map((item) => (
                    <details>
                      <summary>
                        <h3>{item.question}</h3>
                        <span class="plus" aria-hidden="true" />
                      </summary>
                      <p>{item.answer}</p>
                    </details>
                  ))}
              </div>
            </section>
          ))
        }
      </div>
    </div>
  </section>
  <EndCard />
</Page>
