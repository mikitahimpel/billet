---
import Art from "../../components/art.astro";
import EndCard from "../../components/end-card.astro";
import StoreButton from "../../components/store-button.astro";
import { featureList, hub } from "../../features";
import Page from "../../layouts/page.astro";

const schema = [
  {
    "@type": "ItemList",
    name: "Ourio features",
    itemListElement: featureList.map((feature, i) => ({
      "@type": "ListItem",
      position: i + 1,
      name: feature.eyebrow,
      url: new URL(`/features/${feature.slug}/`, Astro.site).href,
    })),
  },
];
---

<Page
  title="Ourio features: everything in the couples app with a shared cat"
  description="Every Ourio feature: a shared room and cat, Lock Screen drawings, photo Moments, a couples planner, date night, wishlists, lists, games and iPhone widgets."
  schema={schema}
  bodyClass="site-hub"
>
  <section class="wrap pg-hero pg-hero-solo">
    <div class="pg-hero-copy">
      <p class="eyebrow">Features</p>
      <h1>Everything in Ourio.</h1>
      <p class="lead">
        Ourio is a free iPhone app for couples built around one shared room and one cat, Mochi. Around her: drawings and
        notes that land on your partner's Lock Screen, photo Moments, a planner for two with date night, wishlists and
        shared lists, a love streak, two games and six widgets. Here is all of it.
      </p>
    </div>
  </section>

  <section class="wrap hub" aria-label="Features">
    <ul class="hub-list">
      {
        featureList.map((feature, i) => (
          <li class:list={["hub-item", i === 0 && "first", "reveal"]}>
            <a href={`/features/${feature.slug}/`}>
              <div class="hub-copy">
                <p class="eyebrow">{feature.eyebrow}</p>
                <h2>{feature.h1}</h2>
                <p>{hub[feature.slug]!.text}</p>
                <span class="hub-more">
                  Read more <span aria-hidden="true">→</span>
                </span>
              </div>
              <div class="hub-art">
                <Art picture={hub[feature.slug]!.picture} eager={i === 0} fitHeight={i === 0 ? "26rem" : "18rem"} />
              </div>
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="pg wrap pg-aside">
    <div class="txt">
      <h2 class="pg-h2">What Ourio doesn't do</h2>
      <ul class="dots">
        <li>No chat and no feed: things arrive quietly, with no thread to keep up with.</li>
        <li>No ads, no tracking, no AI training on your photos or drawings.</li>
        <li>No in-app purchases: every coin is earned together.</li>
        <li>No Android or iPad version yet: Ourio needs two iPhones on iOS 18 or later.</li>
      </ul>
    </div>
    <div class="pg-aside-cta"><StoreButton /></div>
  </section>

  <EndCard />
</Page>
