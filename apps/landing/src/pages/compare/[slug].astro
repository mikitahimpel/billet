---
import type { GetStaticPaths } from "astro";
import { getImage } from "astro:assets";
import mochiPortrait from "../../assets/mochi-portrait.webp";
import CompareTable from "../../components/compare-table.astro";
import EndCard from "../../components/end-card.astro";
import StoreButton from "../../components/store-button.astro";
import { alternatives, apps, checked, ourio, type Alternative } from "../../compare";
import Page from "../../layouts/page.astro";

export const getStaticPaths = (() =>
  alternatives.map((page) => ({ params: { slug: page.slug }, props: { page } }))) satisfies GetStaticPaths;

const { page } = Astro.props as { page: Alternative };
const other = apps.find((app) => app.name === page.app)!;
const schema = [
  {
    "@type": "FAQPage",
    mainEntity: page.questions.map((item) => ({
      "@type": "Question",
      name: item.question,
      acceptedAnswer: { "@type": "Answer", text: item.answer },
    })),
  },
];
const fits = [
  { id: "they-fit", heading: `When ${page.app} is the better pick`, items: page.theyFit },
  { id: "ours-fit", heading: "When Ourio fits better", items: page.oursFit },
];
const [mochiSmall, mochi] = await Promise.all(
  [192, 320].map((width) => getImage({ src: mochiPortrait, width, format: "webp" })),
);
---

<Page title={page.title} description={page.description} schema={schema} bodyClass="site-compare">
  <section class="wrap pg-hero pg-hero-solo">
    <div class="pg-hero-copy">
      <p class="eyebrow">{page.app} alternative</p>
      <h1>{page.h1}</h1>
      <p class="lead">{page.lead}</p>
      <p class="pg-small">
        We make Ourio. {page.app}'s prices and features are from its own App Store page and website, checked <time
          datetime={checked.iso}>{checked.label}</time
        >.
      </p>
      <div class="pg-cta"><StoreButton /></div>
    </div>
  </section>

  <section class="pg wrap" aria-labelledby="side-by-side">
    <h2 id="side-by-side" class="pg-h2">Ourio vs {page.app}</h2>
    <CompareTable apps={[ourio, other]} caption={`Ourio and ${page.app} side by side.`} />
  </section>

  <div class="pg wrap pg-cols">
    {
      fits.map((fit) => (
        <section id={fit.id} class="pg-col">
          <div class="txt">
            <h2 class="pg-h2">{fit.heading}</h2>
            <ul class="dots">
              {fit.items.map((item) => (
                <li>{item}</li>
              ))}
            </ul>
          </div>
        </section>
      ))
    }
  </div>

  <section class="pg wrap pg-split" aria-labelledby="questions">
    <div class="qs-side">
      <h2 id="questions" class="pg-h2">Questions</h2>
      <p class="pg-note">More answers in the <a href="/faq/">FAQ</a> and the <a href="/help/">help pages</a>.</p>
      <img
        class="qs-mochi"
        src={mochi.src}
        srcset={`${mochiSmall.src} 192w, ${mochi.src} 320w`}
        sizes="150px"
        alt=""
        width="320"
        height="320"
        loading="lazy"
        decoding="async"
      />
    </div>
    <div class="qs qs-static">
      {
        page.questions.map((item) => (
          <div>
            <h3>{item.question}</h3>
            <p>{item.answer}</p>
          </div>
        ))
      }
    </div>
  </section>

  <section class="pg wrap" aria-labelledby="more">
    <h2 id="more" class="pg-h2">More comparisons</h2>
    <p class="pg-para">
      See <a href="/compare/">all couples apps compared</a>{
        alternatives
          .filter((alternative) => alternative.slug !== page.slug)
          .map((alternative) => (
            <>
              , or the <a href={`/compare/${alternative.slug}/`}>{alternative.app} alternative</a>
            </>
          ))
      }. Sources: {
        other.sources.map((url, i) => (
          <>
            {i > 0 && ", "}
            <a href={url} rel="nofollow noopener">
              {url.replace(/^https:\/\/(www\.)?/, "")}
            </a>
          </>
        ))
      }.
    </p>
  </section>

  <EndCard />
</Page>
