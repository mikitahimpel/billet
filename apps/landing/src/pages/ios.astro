---
import Analytics from "../components/analytics.astro";
import { appStoreUrl } from "../config";
---

{/* The short link in the TikTok profile. It counts the visit, then hands over to the App Store listing.
    A server redirect would skip the analytics scripts, so this is a page that leaves on its own. */}
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>Ourio on the App Store</title>
    <meta http-equiv="refresh" content={`3;url=${appStoreUrl}`} />
    <script is:inline>
      // Links without their own tags are the TikTok profile link. The tags go into the address before the
      // analytics scripts read it, so Umami and GA4 file the visit under tiktok / social.
      if (!/[?&]utm_source=/.test(location.search))
        history.replaceState(null, "", location.pathname + "?utm_source=tiktok&utm_medium=social&utm_campaign=profile");
    </script>
    <Analytics />
    <style>
      body {
        margin: 0;
        min-height: 100vh;
        display: grid;
        place-items: center;
        background: #0a0605;
        color: #f6ead8;
        font: 16px/1.5 system-ui, sans-serif;
      }
      a {
        color: inherit;
      }
    </style>
  </head>
  <body>
    <p>Opening the App Store… <a id="go" href={appStoreUrl}>Open Ourio</a></p>
    <script is:inline define:vars={{ appStoreUrl }}>
      (function () {
        let gone = false;
        const go = function () {
          if (gone) return;
          gone = true;
          location.replace(appStoreUrl);
        };
        // Leave once both hits are out, or after 1.5 s if a blocker holds either script back.
        setTimeout(go, 1500);
        if (location.hostname !== "ourio.app") return;
        let left = 2;
        const done = function () {
          if (--left === 0) go();
        };
        gtag("event", "app_store_click", { where: "tiktok", event_callback: done, event_timeout: 1200 });
        const umamiHits = function () {
          if (!window.umami) return done();
          Promise.all([window.umami.track(), window.umami.track("app_store_click", { where: "tiktok" })]).then(done, done);
        };
        if (window.umami) umamiHits();
        else {
          const s = document.querySelector('script[src="https://stats.itsnexis.com/s.js"]');
          if (s) s.addEventListener("load", umamiHits, { once: true });
          else done();
        }
      })();
    </script>
  </body>
</html>
