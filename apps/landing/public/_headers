# Cloudflare Pages response headers. /_astro/ names carry a content hash; fonts and room renders keep their names, so
# they are cached for a month, not forever.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable
/fonts/*
  Cache-Control: public, max-age=2592000
/room/*
  Cache-Control: public, max-age=2592000
