	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.mikitahimpel.billet</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>ourio</string>
				<string>nooki</string>
			</array>
		</dict>
	</array>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>NSCameraUsageDescription</key>
	<string>Ourio uses the camera to scan the invite code on your partner's screen.</string>
	<key>UILaunchScreen</key>
	<dict>
		<key>UIColorName</key>
		<string>LaunchBackground</string>
	</dict>
