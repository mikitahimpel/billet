{
  "$schema": "https://turborepo.com/schema.json",
  "extends": ["//"],
  "tasks": {
    "ios:format:check": {
      "inputs": [
        "$TURBO_EXTENDS$",
        "**/*.swift",
        "$TURBO_ROOT$/packages/ios/*/Sources/**/*.swift",
        "$TURBO_ROOT$/packages/ios/scripts/check-design.mjs",
        "$TURBO_ROOT$/packages/ios/scripts/design-baseline.json"
      ]
    }
  }
}
