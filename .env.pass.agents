# Proton Pass references for agents reading the admin panel's data (vault "Ourio").
# Never put real values here. Run:
#   PROTON_PASS_AGENT_REASON="<reason>" pp run --env-file .env.pass.agents -- scripts/admin-read.sh flags
# See docs/admin.md#agent-api. The owner creates the service token; agents never create credentials.
# The API host is not here: scripts/admin-read.sh reads it from a local file (see the script).
CF_ACCESS_CLIENT_ID=pass://Ourio/cloudflare-agents/client_id
CF_ACCESS_CLIENT_SECRET=pass://Ourio/cloudflare-agents/client_secret
