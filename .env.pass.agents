# Proton Pass references for agents reading the admin panel's data (vault "Billet").
# Never put real values here. Run:
#   PROTON_PASS_AGENT_REASON="<reason>" pp run --env-file .env.pass.agents -- scripts/admin-read.sh flags
# See docs/admin.md#agent-api. The owner creates the service token; agents never create credentials.
BILLET_ADMIN_HOST=pass://Billet/cloudflare-access/host
CF_ACCESS_CLIENT_ID=pass://Billet/cloudflare-agents/client_id
CF_ACCESS_CLIENT_SECRET=pass://Billet/cloudflare-agents/client_secret
